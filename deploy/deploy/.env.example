MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_APP_PASSWORD=change-me-app
REDIS_PASSWORD=change-me-redis
GATEWAY_PORT=8080
# JWT 签名密钥（token.secret），生产必须轮换
TOKEN_SECRET=change-me-token-secret
# drug-rag 与 backend 之间的内部服务令牌
KNOWLEDGE_INTERNAL_TOKEN=change-me-knowledge-token
# 支付宝沙箱应用配置，留空则支付功能不可用
ALIPAY_APPID=
ALIPAY_APP_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
# 覆盖 application.yml 里的本地默认口令。Spring Boot 不会自动读 .env，
# 本地直跑后端时请自行导出为环境变量；走 docker compose 时数据源口令由
# MYSQL_APP_PASSWORD 提供，无需设置这两项。
SPRING_DATASOURCE_DRUID_MASTER_PASSWORD=
DRUID_LOGIN_PASSWORD=

